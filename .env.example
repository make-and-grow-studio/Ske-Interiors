# Copy to .env and fill in. Values starting PUBLIC_ are visible in the browser.

# Analytics (CLAUDE.md: GA4 generate_lead, click_call, click_whatsapp; Meta Pixel Lead)
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=

# Google Business Profile URL for the rating line (hidden when empty)
PUBLIC_GBP_URL=

# Forms: Web3Forms access key, Google Sheet (Apps Script) webhook, lead email
PUBLIC_WEB3FORMS_KEY=
SHEET_WEBHOOK_URL=
LEAD_EMAIL=
