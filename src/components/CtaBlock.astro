---
/**
 * Call-to-action block: heading, short text, two buttons, optional full-bleed
 * background photo (Renova closing section). An optional "aside" slot sits
 * on the right (e.g. address, phones and "Show map" on the Home page).
 *
 *   <CtaBlock
 *     heading="Ready to start?"
 *     primary={{ label: 'Get a free quote', href: '/get-a-quote/' }}
 *     secondary={{ label: 'See our work', href: '/our-works/' }}
 *     image={photo} />
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './ui/Button.astro';
import TextLink from './ui/TextLink.astro';

type Action = { label: string; href: string; track?: 'click_call' | 'click_whatsapp'; external?: boolean };
type Props = {
  heading: string;
  text?: string;
  primary: Action;
  secondary?: Action;
  /** Show the secondary action as a text link instead of an outline button */
  secondaryAsLink?: boolean;
  image?: ImageMetadata;
  /** Where the photo's focal point sits, e.g. "center 40%" */
  imagePosition?: string;
  /** Without an image: dark (espresso) or light (ivory) */
  tone?: 'dark' | 'light';
  headingLevel?: 'h2' | 'h3';
  id?: string;
};

const {
  heading,
  text,
  primary,
  secondary,
  secondaryAsLink = false,
  image,
  imagePosition = 'center',
  tone = 'dark',
  headingLevel: H = 'h2',
  id,
} = Astro.props;

const hasAside = Astro.slots.has('aside');
const surface = image ? 'surface-photo' : tone === 'dark' ? 'surface-dark' : '';
const linkAttrs = (a: Action) => ({
  'data-track': a.track,
  ...(a.external ? { target: '_blank', rel: 'noopener' } : {}),
});
---

<section class:list={['cta', image && 'cta--photo', !image && `cta--${tone}`, surface]} id={id}>
  {
    image && (
      <div class="cta__media" aria-hidden="true">
        <Picture
          src={image}
          alt=""
          formats={['avif', 'webp']}
          widths={[640, 1024, 1440, 1920]}
          sizes="100vw"
          style={`object-position:${imagePosition}`}
          class="cta__img"
        />
      </div>
    )
  }
  <div class:list={['cta__inner container-page', hasAside && 'cta__inner--aside']}>
    <div class="cta__main">
      <H class="cta__heading">{heading}</H>
      {text && <p class="cta__text">{text}<slot name="note" /></p>}
      <div class="cta__actions">
        <Button href={primary.href} {...linkAttrs(primary)}>{primary.label}</Button>
        {
          secondary &&
            (secondaryAsLink ? (
              <TextLink href={secondary.href} arrow {...linkAttrs(secondary)}>
                {secondary.label}
              </TextLink>
            ) : (
              <Button href={secondary.href} variant="secondary" {...linkAttrs(secondary)}>
                {secondary.label}
              </Button>
            ))
        }
      </div>
    </div>
    {
      hasAside && (
        <div class="cta__aside">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    color: var(--ink);
  }
  .cta--dark {
    background: var(--espresso);
  }
  .cta--light {
    background: var(--ivory);
    border-block: 1px solid var(--hairline);
  }

  /* Full-bleed photo with a flat espresso scrim (no gradients) */
  .cta__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--espresso);
  }
  .cta__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(34 29 24 / 0.6);
  }

  .cta__inner {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--section-y);
  }
  .cta--photo .cta__inner {
    min-height: min(80svh, 44rem);
    align-content: end;
  }
  @media (min-width: 1024px) {
    .cta__inner--aside {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: var(--grid-gap);
      align-items: end;
    }
  }

  .cta__heading {
    margin: 0;
    max-width: 16ch;
    font-size: var(--step-6);
  }
  .cta__text {
    margin: var(--space-5) 0 0;
    max-width: 48ch;
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    margin-top: var(--space-6);
  }

  .cta__aside {
    padding-top: var(--space-5);
    border-top: 1px solid var(--hairline);
    font-size: var(--step-n1);
    line-height: 1.6;
  }
  @media (min-width: 1024px) {
    .cta__aside {
      padding: 0 0 0 var(--space-6);
      border-top: 0;
      border-left: 1px solid var(--hairline);
    }
  }
</style>
