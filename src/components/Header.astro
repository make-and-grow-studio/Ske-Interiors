---
/**
 * Site header: logo left, nav centre, "Get a free quote" right.
 *
 *  - overlay: transparent over the home hero photo (white text, light logo),
 *             turns solid once you scroll past the top of the page
 *  - solid:   ivory with a hairline (inner pages)
 *
 * Always visible (sticky), so "Get a free quote" is always on screen on
 * desktop. Below 768px the quote button moves to the bottom bar.
 * Behaviour lives in src/scripts/header.ts.
 */
import { Image } from 'astro:assets';
import Button from './ui/Button.astro';
import { nav, quoteHref, business, whatsappUrl } from '../data/site';
import logoDark from '../assets/brand/ske-logo-dark.png';
import logoLight from '../assets/brand/ske-logo-light.png';

type Props = {
  variant?: 'overlay' | 'solid';
  /** Path of the current page, to mark the active nav item */
  current?: string;
  /** Design-system demos: render in place, no sticky/fixed positioning */
  static?: boolean;
  class?: string;
};

const { variant = 'solid', current = Astro.url.pathname, static: isStatic = false, class: className } = Astro.props;

const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
const logoHeight = 34;
const logoWidth = Math.round((logoHeight * logoDark.width) / logoDark.height);
const idSuffix = `${variant}${isStatic ? '-demo' : ''}`;
const menuId = `mobile-menu-${idSuffix}`;
---

<header
  class:list={[
    'site-header',
    `site-header--${variant}`,
    variant === 'overlay' ? 'surface-photo' : 'is-solid',
    isStatic && 'site-header--static',
    className,
  ]}
  data-header={isStatic ? undefined : variant}
>
  <div class="site-header__inner container-page">
    <a href="/" class="site-header__logo" aria-label="SKE Interiors, home">
      <Image src={logoLight} alt="" width={logoWidth} height={logoHeight} densities={[1, 2]} loading="eager" class="logo-light" />
      <Image src={logoDark} alt="" width={logoWidth} height={logoHeight} densities={[1, 2]} loading="eager" class="logo-dark" />
    </a>

    <nav class="site-header__nav" aria-label="Main">
      <ul class="site-header__list">
        {
          nav.map((item) =>
            item.children ? (
              <li class="has-menu" data-dropdown>
                <button
                  type="button"
                  class="site-header__link"
                  aria-expanded="false"
                  aria-controls={`services-menu-${idSuffix}`}
                  data-current={item.children.some((c) => isActive(c.href)) ? 'true' : undefined}
                >
                  {item.label}
                  <svg viewBox="0 0 12 8" aria-hidden="true" class="site-header__caret">
                    <path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </button>
                <ul id={`services-menu-${idSuffix}`} class="dropdown" hidden>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} class="site-header__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={quoteHref} class="site-header__cta">Get a free quote</Button>
      <button
        type="button"
        class="site-header__menu-btn"
        aria-haspopup="dialog"
        aria-controls={menuId}
        data-menu-open
      >
        <span>Menu</span>
        <svg viewBox="0 0 24 12" aria-hidden="true">
          <path d="M0 1h24M0 11h24" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Full-screen mobile menu. <dialog> gives focus trapping and Esc for free. -->
  <dialog id={menuId} class="menu" aria-label="Menu" data-menu>
    <div class="menu__top container-page">
      <a href="/" class="site-header__logo" aria-label="SKE Interiors, home">
        <Image src={logoDark} alt="" width={logoWidth} height={logoHeight} densities={[1, 2]} />
      </a>
      <button type="button" class="site-header__menu-btn" data-menu-close autofocus>
        <span>Close</span>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>

    <nav class="menu__nav container-page" aria-label="Menu">
      <ul class="menu__list">
        {
          nav.map((item) =>
            item.children ? (
              <li class="menu__group">
                <p class="menu__label">{item.label}</p>
                <ul>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} class="menu__link menu__link--sub" aria-current={isActive(c.href) ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} class="menu__link" aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
      <Button href={quoteHref} block class="menu__cta">Get a free quote</Button>
    </nav>

    <div class="menu__contact container-page">
      <a href={`tel:${business.phones.mobile[0].tel}`} data-track="click_call">
        <span class="menu__contact-label">Call</span>
        {business.phones.mobile[0].label}
      </a>
      <a href={whatsappUrl()} target="_blank" rel="noopener" data-track="click_whatsapp">
        <span class="menu__contact-label">WhatsApp</span>
        Message us
      </a>
    </div>
  </dialog>
</header>

<script>
  import '../scripts/header';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--ink);
    border-bottom: 1px solid var(--hairline);
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }
  /* Over the hero: fixed so the photo runs under it */
  .site-header--overlay {
    position: fixed;
    inset: 0 0 auto;
    background: transparent;
  }
  .site-header.is-solid {
    background: var(--ivory);
  }
  .site-header--static {
    position: relative;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 72px;
  }
  @media (min-width: 1024px) {
    .site-header__inner {
      min-height: 88px;
    }
  }

  /* Logo: light over photos, dark on ivory */
  .site-header__logo {
    display: block;
    flex: none;
  }
  .site-header__logo :global(img) {
    display: block;
    height: 26px;
    width: auto;
  }
  @media (min-width: 1024px) {
    .site-header__logo :global(img) {
      height: 34px;
    }
  }
  .site-header :global(.logo-dark) {
    display: none;
  }
  .site-header.is-solid :global(.logo-dark) {
    display: block;
  }
  .site-header.is-solid :global(.logo-light) {
    display: none;
  }

  /* Desktop nav */
  .site-header__nav {
    display: none;
  }
  @media (min-width: 1024px) {
    .site-header__nav {
      display: block;
    }
  }
  .site-header__list {
    display: flex;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.8em;
    transition: text-decoration-color var(--duration-fast) ease;
  }
  .site-header__link:hover,
  .site-header__link[aria-current='page'],
  .site-header__link[data-current='true'],
  .site-header__link[aria-expanded='true'] {
    text-decoration-color: var(--accent-line);
  }
  .site-header__caret {
    width: 10px;
    height: 7px;
    transition: rotate var(--duration-fast) ease;
  }
  [aria-expanded='true'] > .site-header__caret {
    rotate: 180deg;
  }

  /* Services dropdown: an ivory panel, whatever the header colour */
  .has-menu {
    position: relative;
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 1rem);
    left: -1.25rem;
    min-width: 16rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: var(--ivory);
    border: 1px solid var(--sand);
    color: var(--graphite);
    --accent: var(--gold-deep);
  }
  .dropdown a {
    display: block;
    padding: 0.8rem 1.25rem;
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .dropdown a:hover,
  .dropdown a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-underline-offset: 0.5em;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .site-header__actions :global(.site-header__cta) {
    display: none;
  }
  @media (min-width: 768px) {
    .site-header__actions :global(.site-header__cta) {
      display: inline-flex;
    }
  }

  .site-header__menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 0.25rem;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
  }
  .site-header__menu-btn svg {
    width: 24px;
    height: 12px;
  }
  .site-header__menu-btn svg[viewBox='0 0 16 16'] {
    width: 16px;
    height: 16px;
  }
  @media (min-width: 1024px) {
    .site-header__actions > .site-header__menu-btn {
      display: none;
    }
  }

  /* ---- Full-screen mobile menu ---- */
  .menu {
    /* reset the light/photo tokens: the menu is always ivory */
    --ink: var(--graphite);
    --ink-muted: var(--graphite-muted);
    --ink-strong: var(--espresso);
    --accent: var(--gold-deep);
    --hairline: var(--sand);
    --on-ink: var(--ivory);
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ivory);
    color: var(--graphite);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu[open] {
    display: flex;
    flex-direction: column;
  }
  .menu::backdrop {
    background: var(--espresso);
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] {
      animation: menu-in var(--duration-fast) ease both;
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    border-bottom: 1px solid var(--sand);
  }
  .menu__nav {
    flex: 1;
    padding-block: var(--space-6);
  }
  .menu__list {
    display: grid;
    gap: 0.25rem;
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }
  .menu__list ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu__link {
    display: block;
    padding-block: 0.35rem;
    font-family: var(--family-display);
    font-size: var(--step-4);
    font-weight: var(--weight-display);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    text-decoration: none;
  }
  .menu__link--sub {
    padding-left: 1rem;
    font-size: var(--step-3);
  }
  .menu__link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .menu__group {
    padding-block: 0.25rem;
  }
  .menu__label {
    margin: 0.75rem 0 0.25rem;
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--gold-deep);
  }
  .menu__contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
    padding-block: var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--sand);
  }
  .menu__contact a {
    display: grid;
    gap: 0.15rem;
    font-weight: 500;
    text-decoration: none;
  }
  .menu__contact-label {
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--gold-deep);
  }
</style>
