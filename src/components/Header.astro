---
/**
 * Site header: logo left, nav centre, "Get a free quote" right.
 *
 * Two looks:
 *  - overlay: transparent over the home hero photo, white text, light logo
 *  - solid:   plaster background with a hairline (inner pages, and the home
 *             page once you scroll)
 *
 * Prompt 00–02: visual only. Prompt 03 adds the sticky/scroll behaviour,
 * the Services dropdown and the full-screen mobile menu.
 */
import { Image } from 'astro:assets';
import Button from './ui/Button.astro';
import logoDark from '../assets/brand/ske-logo-dark.png';
import logoLight from '../assets/brand/ske-logo-light.png';

type Props = {
  variant?: 'overlay' | 'solid';
  /** Path of the current page, to mark the active nav item */
  current?: string;
  class?: string;
};

const { variant = 'solid', current = '/', class: className } = Astro.props;

const nav = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about-us/' },
  { label: 'Services', href: '/residential-interiors/', hasMenu: true },
  { label: 'Our work', href: '/our-works/' },
  { label: 'Contact', href: '/contact-us/' },
];
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class:list={['site-header', `site-header--${variant}`, variant === 'overlay' && 'surface-photo', className]}>
  <div class="site-header__inner container-page">
    <a href="/" class="site-header__logo" aria-label="SKE Interiors, home">
      <Image
        src={variant === 'overlay' ? logoLight : logoDark}
        alt=""
        height={34}
        width={Math.round((34 * logoDark.width) / logoDark.height)}
        loading="eager"
        densities={[1, 2]}
      />
    </a>

    <nav class="site-header__nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
                {item.hasMenu && (
                  <svg viewBox="0 0 12 8" aria-hidden="true" class="site-header__caret">
                    <path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href="/get-a-quote/" class="site-header__cta">Get a free quote</Button>
      <button type="button" class="site-header__menu" aria-label="Open menu">
        <span>Menu</span>
        <svg viewBox="0 0 24 12" aria-hidden="true">
          <path d="M0 1h24M0 11h24" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    color: var(--ink);
  }
  .site-header--solid {
    background: var(--lime-plaster);
    border-bottom: 1px solid var(--hairline);
  }
  .site-header--overlay {
    background: transparent;
    border-bottom: 1px solid var(--hairline);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 72px;
  }
  @media (min-width: 1024px) {
    .site-header__inner {
      min-height: 88px;
    }
  }

  .site-header__logo {
    display: block;
    flex: none;
  }
  .site-header__logo :global(img) {
    display: block;
    height: 28px;
    width: auto;
  }
  @media (min-width: 1024px) {
    .site-header__logo :global(img) {
      height: 34px;
    }
  }

  /* Desktop nav */
  .site-header__nav {
    display: none;
  }
  @media (min-width: 1024px) {
    .site-header__nav {
      display: block;
    }
  }
  .site-header__nav ul {
    display: flex;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-block: 0.5rem;
    font-size: var(--step-n1);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.45em;
    transition: text-decoration-color var(--duration-fast) ease;
  }
  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    text-decoration-color: var(--accent);
  }
  .site-header__nav a[aria-current='page'] {
    text-decoration-thickness: 2px;
  }
  .site-header__caret {
    width: 10px;
    height: 7px;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* The quote button lives in the mobile bottom bar below 768px */
  .site-header__actions :global(.site-header__cta) {
    display: none;
  }
  @media (min-width: 768px) {
    .site-header__actions :global(.site-header__cta) {
      display: inline-flex;
    }
  }

  .site-header__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 0.25rem;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: var(--step-n1);
    font-weight: 500;
    cursor: pointer;
  }
  .site-header__menu svg {
    width: 24px;
    height: 12px;
  }
  @media (min-width: 1024px) {
    .site-header__menu {
      display: none;
    }
  }
</style>
