---
/**
 * Fixed bottom bar on phones (below 768px): Call · WhatsApp · Get a quote.
 * Keeps a way to get in touch on screen at all times (CLAUDE.md lead-gen).
 * Clicks are tracked as click_call / click_whatsapp (see Analytics.astro).
 */
import { business, whatsappUrl, quoteHref } from '../data/site';
const phone = business.phones.mobile[0];
---

<nav class="mobile-bar" aria-label="Contact shortcuts">
  <a href={`tel:${phone.tel}`} class="mobile-bar__item" data-track="click_call">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M6.6 3.5h2.9l1.4 4.1-2 1.4a12 12 0 0 0 6.1 6.1l1.4-2 4.1 1.4v2.9c0 1-.8 1.8-1.8 1.8A15.6 15.6 0 0 1 4.8 5.3c0-1 .8-1.8 1.8-1.8Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"></path>
    </svg>
    <span>Call</span>
  </a>
  <a href={whatsappUrl()} target="_blank" rel="noopener" class="mobile-bar__item" data-track="click_whatsapp">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        d="M12 3.5a8.5 8.5 0 0 0-7.3 12.9L3.5 20.5l4.2-1.1A8.5 8.5 0 1 0 12 3.5Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"></path>
      <path
        d="M9 8.6c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5a6 6 0 0 0 2.6 2.3c.2.1.4 0 .5-.1l.6-.7c.2-.2.3-.2.6-.1l1.5.7c.3.1.4.2.4.4 0 .5-.2 1.2-.8 1.5-.6.4-1.5.6-3.3-.2-2.2-.9-3.6-3.2-3.7-3.4-.1-.2-.9-1.2-.9-2.3 0-.9.4-1.4.7-1.7Z"
        fill="currentColor"></path>
    </svg>
    <span>WhatsApp</span>
  </a>
  <a href={quoteHref} class="mobile-bar__item mobile-bar__item--primary">
    <span>Get a quote</span>
  </a>
</nav>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--ivory);
    border-top: 1px solid var(--sand);
    color: var(--graphite);
  }
  @media (min-width: 768px) {
    .mobile-bar {
      display: none;
    }
  }
  .mobile-bar__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 56px;
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .mobile-bar__item + .mobile-bar__item {
    border-left: 1px solid var(--sand);
  }
  .mobile-bar__item svg {
    width: 20px;
    height: 20px;
  }
  .mobile-bar__item--primary {
    background: var(--graphite);
    color: var(--ivory);
  }
  .mobile-bar__item:focus-visible {
    outline: 2px solid var(--gold-deep);
    outline-offset: -4px;
  }
  .mobile-bar__item--primary:focus-visible {
    outline-color: var(--ivory);
  }
</style>
