---
/**
 * Home 1.3: Services. A chequerboard of text cards and photo tiles
 * (Modora's "Complete interior services" grid), three services, not numbered.
 *
 * Desktop (≥1024): three columns. Each column is one service, so the photo
 * always sits next to its own card: card over photo, photo over card, card
 * over photo. Tablet: one row per service, card and photo side by side,
 * alternating. Phone: photo, then card.
 *
 * No motion here on purpose (CLAUDE.md: motion is spent on the hero,
 * the design-vs-reality reveal and the process).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TextLink from '../ui/TextLink.astro';
import Placeholder from '../Placeholder.astro';
import { services } from '../../data/home';
import residentialPhoto from '../../../scrape/images/shared/FB_IMG_1669397490899.jpg';
import commercialPhoto from '../../../scrape/images/shared/20190131_190709_5ce9bae3-d83b-4728-af5e-0cfe4f01126b.jpg';
import flooringPhoto from '../../../scrape/images/shared/FB_IMG_1669397487697.jpg';

/** One photo per card. `stand-in` = not the real subject yet (TODO-client, Home) */
const photos: { src: ImageMetadata; alt: string; position?: string; standIn?: string }[] = [
  { src: residentialPhoto, alt: 'Bedroom with a walnut headboard wall and study desk, designed by SKE Interiors' },
  {
    src: commercialPhoto,
    alt: 'Study with built-in desks, shelving and storage, designed by SKE Interiors',
    position: 'center 60%',
    standIn: 'a home study until SKE sends commercial photos',
  },
  {
    src: flooringPhoto,
    alt: 'Bathroom with marble walls and floor and a floating vanity, designed by SKE Interiors',
    standIn: 'no flooring photos yet',
  },
];
---

<section class="services" aria-labelledby="services-heading">
  <div class="container-page">
    <p class="eyebrow services__eyebrow">Services</p>
    <h2 id="services-heading" class="services__heading">{services.heading}</h2>

    <div class="services__grid">
      {
        services.items.map((s, i) => {
          const photo = photos[i];
          return (
            <article class:list={['service', i % 2 === 1 && 'service--flip']}>
              <div class="service__card">
                <h3 class="service__title">{s.title}</h3>
                <div class="service__bottom">
                  <p class="service__text">{s.text}</p>
                  <TextLink href={s.link.href} arrow>
                    {s.link.label}
                  </TextLink>
                </div>
              </div>
              <figure class="service__photo">
                <Picture
                  src={photo.src}
                  alt={photo.alt}
                  formats={['avif', 'webp']}
                  widths={[420, 640, 900]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  style={photo.position ? `object-position: ${photo.position}` : undefined}
                />
                {photo.standIn && (
                  <figcaption class="service__todo">
                    <Placeholder>IMG: {photo.standIn}</Placeholder>
                  </figcaption>
                )}
              </figure>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: 0 var(--section-y);
  }
  .services__eyebrow {
    margin: 0 0 var(--space-5);
  }
  .services__heading {
    margin: 0 0 var(--space-7);
    max-width: 14ch;
    font-size: var(--step-5);
  }
  @media (min-width: 768px) {
    .services__heading {
      font-size: var(--step-6);
    }
  }

  /* ---- Grid ---- */
  .services__grid {
    display: grid;
    gap: var(--space-7);
  }
  .service {
    display: grid;
    min-width: 0;
  }

  /* Phone: photo first, then the card */
  .service__photo {
    order: -1;
    margin: 0;
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sand);
  }
  .service__photo :global(picture) {
    display: block;
    height: 100%;
  }
  .service__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .service__todo {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
  }

  .service__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-5) var(--space-5);
    background: var(--paper);
  }
  .service__title {
    margin: 0;
    font-family: var(--family-display);
    font-weight: var(--weight-display);
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }
  /* fine gold rule between the title and the text */
  .service__bottom {
    border-top: 1px solid var(--accent-line);
    padding-top: var(--space-5);
  }
  .service__text {
    margin: 0 0 var(--space-3);
    color: var(--ink-muted);
    max-width: 40ch;
  }

  /* Tablet: card and photo side by side, alternating sides */
  @media (min-width: 768px) {
    .services__grid {
      gap: var(--grid-gap);
    }
    .service {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--grid-gap);
    }
    .service__photo {
      order: 0;
      aspect-ratio: auto; /* stretch to the card's height */
      min-height: 20rem;
    }
    .service--flip .service__photo {
      order: -1;
    }
    .service__card {
      padding: var(--space-6);
    }
  }

  /* Desktop: three columns, each a stack of two square tiles */
  @media (min-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--grid-gap);
    }
    .service {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr 1fr;
      row-gap: var(--grid-gap);
    }
    .service__photo {
      aspect-ratio: 1 / 1;
      min-height: 0;
    }
    .service__card {
      aspect-ratio: 1 / 1;
      padding: var(--space-7) var(--space-6) var(--space-6);
    }
  }
</style>
