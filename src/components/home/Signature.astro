---
/**
 * Home 1.4: Signature, design vs reality (motion moment 2 of 3).
 *
 * Two images of the same room stacked in one frame: the 3D render and the
 * finished photo. A handle splits them (left = design, right = finished).
 * On desktop with a mouse, moving over the render also brushes the finished
 * photo through a soft mask that heals back ~1.5s after the cursor stops.
 * Behaviour lives in src/scripts/compare.ts.
 *
 * Phone / touch: handle only. Keyboard: the handle is a slider (←/→ 5%,
 * Page Up/Down 10%, Home/End). Reduced motion: design and finished room
 * side by side, no handle, no brush.
 *
 * CONTENT: SKE hasn't sent real render + photo pairs yet. Until they do, the
 * pairs below are dev-only placeholders (a render shown in grey as the
 * "design", in colour as the "finished room"). Placeholder pairs never ship:
 * with no real pairs the whole section is left out of the production build.
 * Listed in /TODO-client.md.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from '../Placeholder.astro';
import { signature } from '../../data/home';
import livingRender from '../../../scrape/images/shared/20190131_190716_6c612b6a-b7c3-4886-9258-8336a29b1a6e.jpg';
import bedroomRender from '../../../scrape/images/shared/20190131_190718_61abca03-514e-4748-ae8a-347b4f593de4.jpg';

type Pair = {
  room: string;
  design: { src: ImageMetadata; alt: string };
  reality: { src: ImageMetadata; alt: string };
  /** true = stand-in, shown in development only */
  placeholder?: boolean;
};

const pairs: Pair[] = [
  {
    room: 'Living room',
    design: { src: livingRender, alt: '3D design of a living room with a TV partition, designed by SKE Interiors' },
    reality: { src: livingRender, alt: 'Placeholder: finished living room photo still to come' },
    placeholder: true,
  },
  {
    room: 'Bedroom',
    design: { src: bedroomRender, alt: '3D design of a bedroom with a wardrobe wall, designed by SKE Interiors' },
    reality: { src: bedroomRender, alt: 'Placeholder: finished bedroom photo still to come' },
    placeholder: true,
  },
];

const showPlaceholders = import.meta.env.DEV || import.meta.env.PUBLIC_SHOW_PLACEHOLDERS === 'true';
const shown = pairs.filter((p) => !p.placeholder || showPlaceholders);
const sizes = '(min-width: 1024px) 60vw, 100vw';
---

{
  shown.length > 0 && (
    <section class="signature surface-dark" aria-labelledby="signature-heading">
      <div class="container-page signature__grid">
        <div class="signature__text">
          <p class="eyebrow signature__eyebrow">Design vs reality</p>
          <h2 id="signature-heading" class="signature__heading">
            {signature.heading}
          </h2>
          <p class="signature__body">{signature.body}</p>
          {shown.some((p) => p.placeholder) && (
            <Placeholder>IMG: render + finished photo pairs of the same room (REQUEST FROM SKE)</Placeholder>
          )}
        </div>

        <div class="compare" data-compare style="--pos: 50%">
          <div class="compare__frame" data-frame>
            {shown.map((p, i) => (
              <div
                class:list={['compare__pair', p.placeholder && 'compare__pair--mock']}
                data-pair
                data-active={i === 0 ? '' : undefined}
              >
                <figure class="compare__layer compare__layer--design">
                  <Picture
                    src={p.design.src}
                    alt={p.design.alt}
                    formats={['avif', 'webp']}
                    widths={[640, 960, 1280]}
                    sizes={sizes}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="compare__label">3D design</figcaption>
                </figure>
                <figure class="compare__layer compare__layer--reality">
                  <Picture
                    src={p.reality.src}
                    alt={p.reality.alt}
                    formats={['avif', 'webp']}
                    widths={[640, 960, 1280]}
                    sizes={sizes}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="compare__label compare__label--right">Finished room</figcaption>
                </figure>
              </div>
            ))}

            <!-- Brush reveal (desktop mouse only); drawn by compare.ts -->
            <canvas class="compare__brush" data-brush aria-hidden="true" />

            <!-- Divider: the line is a drag target, the knob is the keyboard slider -->
            <div class="compare__track">
              <div class="compare__line" data-drag />
              <div
                class="compare__knob"
                data-drag
                data-handle
                role="slider"
                tabindex="0"
                aria-label="Drag to compare design and finished room"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="50"
                aria-valuetext="Half design, half finished room"
              >
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                  <path d="M9 6 3 12l6 6M15 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.2" />
                </svg>
              </div>
            </div>
          </div>

          <div class="compare__footer">
            <p class="compare__hint caps">
              <span aria-hidden="true">←&nbsp;→</span>
              {signature.control}
            </p>
            {shown.length > 1 && (
              <div class="compare__thumbs" role="group" aria-label="Choose a room">
                {shown.map((p, i) => (
                  <button
                    type="button"
                    class="compare__thumb"
                    data-thumb={i}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                  >
                    <Picture
                      src={p.design.src}
                      alt=""
                      formats={['avif', 'webp']}
                      widths={[160]}
                      sizes="80px"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="compare__thumb-label">{p.room}</span>
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  import '../../scripts/compare';
</script>

<style>
  .signature {
    padding-block: var(--section-y);
  }
  .signature__grid {
    display: grid;
    row-gap: var(--space-7);
  }
  @media (min-width: 1024px) {
    .signature__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: center;
    }
    .signature__text {
      grid-column: 1 / span 4;
    }
    .compare {
      grid-column: 6 / -1;
    }
  }
  .signature__text {
    min-width: 0;
  }
  .signature__eyebrow {
    margin: 0 0 var(--space-5);
  }
  .signature__heading {
    margin: 0;
    max-width: 16ch;
    font-size: var(--step-5);
  }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .signature__heading {
      font-size: var(--step-6);
    }
  }
  .signature__body {
    margin: var(--space-6) 0 var(--space-4);
    max-width: 44ch;
    color: var(--ink-muted);
  }

  /* ---- The frame ---- */
  .compare {
    min-width: 0;
  }
  .compare__frame {
    position: relative;
    display: grid; /* pairs share one cell so they can crossfade */
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--graphite);
    user-select: none;
    -webkit-user-select: none;
  }
  @media (min-width: 768px) {
    .compare__frame {
      aspect-ratio: 3 / 2;
    }
  }
  .compare__pair {
    grid-area: 1 / 1;
    position: relative;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 200ms ease,
      visibility 0s linear 200ms;
  }
  .compare__pair[data-active] {
    opacity: 1;
    visibility: visible;
    transition: opacity 200ms ease;
  }
  .compare__layer {
    position: absolute;
    inset: 0;
    margin: 0;
  }
  .compare__layer :global(picture) {
    display: block;
    height: 100%;
  }
  .compare__layer :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The finished photo shows to the right of the handle */
  .compare__layer--reality {
    z-index: 2;
    clip-path: inset(0 0 0 var(--pos));
  }
  /* Dev-only stand-in: the render in grey plays the "design" */
  .compare__pair--mock .compare__layer--design :global(img) {
    filter: grayscale(1) contrast(0.9) brightness(1.05);
  }

  .compare__label {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    padding: 0.35rem 0.7rem;
    background: rgb(34 29 24 / 0.55);
    color: var(--white);
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    line-height: 1.4;
  }
  .compare__label--right {
    left: auto;
    right: var(--space-4);
  }
  @media (max-width: 767.98px) {
    .compare__label {
      top: var(--space-3);
      left: var(--space-3);
      padding: 0.25rem 0.5rem;
      letter-spacing: 0.14em;
    }
    .compare__label--right {
      left: auto;
      right: var(--space-3);
    }
  }

  .compare__brush {
    position: absolute;
    inset: 0;
    z-index: 1; /* above the design, below the clipped finished photo */
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ---- Divider ---- */
  .compare__track {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    translate: var(--pos) 0; /* % of the frame width: moves with transform, not layout */
  }
  .compare__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -22px;
    width: 44px; /* invisible 44px drag target around a 1px line */
    pointer-events: auto;
    cursor: ew-resize;
    touch-action: none;
  }
  .compare__line::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--white);
  }
  .compare__knob {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    translate: -50% -50%;
    border-radius: var(--corner-round);
    background: var(--white);
    color: var(--espresso);
    box-shadow: 0 2px 16px rgb(0 0 0 / 0.25);
    pointer-events: auto;
    cursor: ew-resize;
    touch-action: none;
  }
  .compare__knob:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  /* ---- Under the frame ---- */
  .compare__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .compare__hint {
    display: flex;
    gap: 0.8em;
    margin: 0;
    color: var(--ink-muted);
  }
  .compare__hint span {
    color: var(--gold);
    letter-spacing: 0;
  }
  .compare__thumbs {
    display: flex;
    gap: var(--space-3);
  }
  /* Phone: room buttons share the full width under the hint */
  @media (max-width: 767.98px) {
    .compare__thumbs {
      width: 100%;
    }
    .compare__thumb {
      flex: 1 1 0;
      min-width: 0;
    }
  }
  .compare__thumb-label {
    white-space: nowrap;
  }
  .compare__thumb {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-3) 0 0;
    border: 1px solid var(--hairline);
    background: none;
    color: var(--ink-muted);
    font: inherit;
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .compare__thumb :global(img) {
    display: block;
    width: 64px;
    height: 44px;
    object-fit: cover;
  }
  .compare__thumb:hover {
    color: var(--ink);
  }
  .compare__thumb[aria-pressed='true'] {
    border-color: var(--gold);
    color: var(--ink);
  }

  /* ---- Reduced motion: static side by side ---- */
  @media (prefers-reduced-motion: reduce) and (min-width: 768px) {
    .compare__layer.compare__layer {
      aspect-ratio: 4 / 3;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .compare__frame {
      aspect-ratio: auto;
      background: none;
    }
    .compare__pair {
      display: none;
    }
    .compare__pair[data-active] {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2);
    }
    .compare__layer {
      position: relative;
      aspect-ratio: 3 / 4;
    }
    .compare__layer--reality {
      clip-path: none;
    }
    .compare__label--right {
      left: var(--space-4);
      right: auto;
    }
    .compare__brush,
    .compare__track,
    .compare__hint {
      display: none;
    }
  }
</style>
