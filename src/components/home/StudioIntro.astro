---
/**
 * Home studio intro (content file 1.2), after Modora's "Our expertise" block:
 * heading top-left, body and link anchored bottom-left, a tall photo on the
 * right with a small photo dropped lower beside it. Numbers row underneath
 * counts up once when it scrolls into view (src/scripts/count-up.ts).
 *
 * The numbers are real text in the HTML (final values), so search engines,
 * no-JS visitors and reduced-motion visitors all see them as they are.
 *
 * Photos: the content file's picks (residencial1_8, residencial_36) are
 * missing from the old server, so this uses SKE's two best real photos.
 */
import { Picture } from 'astro:assets';
import TextLink from '../ui/TextLink.astro';
import Placeholder from '../Placeholder.astro';
import { intro } from '../../data/home';
import tallPhoto from '../../../scrape/images/shared/FB_IMG_1671554675670.jpg';
import smallPhoto from '../../../scrape/images/shared/FB_IMG_1671554681269.jpg';
---

<section class="intro container-page" aria-labelledby="intro-title">
  <div class="intro__grid">
    <div class="intro__text">
      <p class="eyebrow intro__eyebrow">Studio</p>
      <h2 id="intro-title" class="intro__heading">
        {intro.heading}
      </h2>
      <Placeholder>CONFIRM: {intro.headingConfirm}</Placeholder>
      <div class="intro__body">
        {intro.body.map((p) => <p>{p}</p>)}
        <TextLink href={intro.link.href} arrow>{intro.link.label}</TextLink>
      </div>
    </div>

    <figure class="intro__small">
      <Picture
        src={smallPhoto}
        alt="Kitchen counter with white quartz top, walnut slats and floating shelves in a 2BHK in Coimbatore, designed by SKE Interiors"
        formats={['avif', 'webp']}
        widths={[320, 480, 720]}
        sizes="(min-width: 1024px) 16vw, 45vw"
      />
    </figure>

    <figure class="intro__tall">
      <Picture
        src={tallPhoto}
        alt="Living room with a brass-chain oonjal swing, wood-slat ceiling and TV wall in a 2BHK in Coimbatore, designed by SKE Interiors"
        formats={['avif', 'webp']}
        widths={[480, 720, 1080]}
        sizes="(min-width: 1024px) 38vw, 100vw"
      />
    </figure>
  </div>

  <ul class="intro__numbers" data-count-up>
    {
      intro.numbers.map((n) => (
        <li class="intro__number">
          <span class="intro__value">
            <span data-count-to={n.value}>{n.value}</span>{n.suffix && <span class="intro__suffix">{n.suffix}</span>}
          </span>
          <span class="intro__label">
            {n.label}
            {n.confirm && <Placeholder>{n.confirm.startsWith('update') ? 'UPDATE' : 'CONFIRM'}: {n.confirm}</Placeholder>}
          </span>
        </li>
      ))
    }
  </ul>
</section>

<script>
  import '../../scripts/count-up';
</script>

<style>
  .intro {
    padding-block: var(--section-y);
  }

  /* ---- Layout ---- */
  .intro__grid {
    display: grid;
    row-gap: var(--space-6);
    column-gap: var(--grid-gap); /* 12 columns: a wide gap would overflow phones */
  }
  .intro__eyebrow {
    margin: 0 0 var(--space-5);
  }
  .intro__heading {
    margin: 0;
    max-width: 16ch;
    font-size: var(--step-5);
  }
  @media (min-width: 768px) {
    .intro__heading {
      font-size: var(--step-6);
    }
  }
  @media (min-width: 1024px) {
    .intro__heading {
      max-width: 18ch;
      font-size: var(--step-5);
    }
  }
  .intro__text {
    min-width: 0;
  }
  .intro__body {
    margin-top: var(--space-6);
  }
  .intro__body p {
    margin: 0 0 var(--space-4);
    max-width: 52ch;
  }
  .intro figure {
    margin: 0;
    min-width: 0; /* let photos shrink to their grid column instead of overflowing */
  }
  .intro figure :global(picture) {
    display: block;
    height: 100%;
  }
  .intro figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .intro__tall {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--sand);
  }
  .intro__small {
    aspect-ratio: 3 / 4;
    background: var(--sand);
  }

  /* Phones and tablets: tall photo, small photo tucked over its lower-left corner */
  @media (max-width: 1023.98px) {
    .intro__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .intro__text {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .intro__tall {
      grid-column: 3 / -1;
      grid-row: 2;
    }
    .intro__small {
      grid-column: 1 / 7;
      grid-row: 2;
      align-self: end;
      margin-bottom: -12%;
      border: 8px solid var(--ivory);
      border-left: 0;
      z-index: 1;
    }
  }
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .intro__tall {
      grid-column: 5 / -1;
    }
    .intro__small {
      grid-column: 1 / 6;
    }
  }

  /* Desktop: Modora "Our expertise" arrangement on the 12-column grid */
  @media (min-width: 1024px) {
    .intro__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: stretch;
    }
    .intro__text {
      grid-column: 1 / 6;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding-bottom: var(--space-2);
    }
    .intro__body {
      margin-top: var(--space-9);
    }
    /* Modora: the small photo, the tall photo and the "More about us" link
       all sit on the same bottom line */
    .intro__small {
      grid-column: 6 / 8;
      align-self: end;
    }
    .intro__tall {
      grid-column: 8 / -1;
      align-self: end; /* keep its 4:5 shape; stretching would widen it past the column */
    }
  }

  /* ---- Numbers row ---- */
  .intro__numbers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: var(--space-9) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }
  @media (max-width: 1023.98px) {
    .intro__numbers {
      margin-top: calc(var(--space-9) + 6%);
    }
  }
  @media (min-width: 1024px) {
    .intro__numbers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .intro__number {
    display: grid;
    gap: 0.35rem;
    padding: var(--space-5) var(--space-4) var(--space-5) 0;
  }
  .intro__number:nth-child(even) {
    padding-left: var(--space-5);
    border-left: 1px solid var(--hairline);
  }
  .intro__number:nth-child(n + 3) {
    border-top: 1px solid var(--hairline);
  }
  @media (min-width: 1024px) {
    .intro__number + .intro__number {
      padding-left: var(--space-5);
      border-left: 1px solid var(--hairline);
    }
    .intro__number:nth-child(n + 3) {
      border-top: 0;
    }
  }
  .intro__value {
    font-family: var(--family-display);
    font-size: var(--step-7);
    font-weight: var(--weight-display);
    line-height: 1;
    font-variant-numeric: lining-nums;
  }
  .intro__suffix {
    margin-left: 0.04em;
    font-size: 0.6em;
    vertical-align: 0.5em;
    color: var(--gold);
  }
  .intro__label {
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
</style>
