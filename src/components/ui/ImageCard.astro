---
/**
 * Image card for projects (carousel, Our work grid, project strips).
 * The photo carries the card: no chrome over the image, caption below.
 * Serves AVIF + WebP at several widths with width/height set (no CLS).
 * No hover animation (CLAUDE.md); only the title underline appears.
 *
 *   <ImageCard href="/3bhk-home-interior/" image={img} alt="…" title="3BHK home interior" meta="Coimbatore" />
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  image: ImageMetadata;
  /** Descriptive alt, pattern from the content file */
  alt: string;
  title: string;
  /** Right-hand caption, e.g. location */
  meta?: string;
  /** Small second line, e.g. project type */
  kind?: string;
  href?: string;
  ratio?: 'landscape' | 'portrait' | 'square';
  /** Tell the browser how wide the card is, for the right image size */
  sizes?: string;
  /** Above the fold: load eagerly */
  eager?: boolean;
  class?: string;
};

const {
  image,
  alt,
  title,
  meta,
  kind,
  href,
  ratio = 'landscape',
  sizes = '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw',
  eager = false,
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'div';
---

<article class:list={['card', `card--${ratio}`, className]}>
  <Tag href={href} class="card__link">
    <div class="card__media">
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        class="card__img"
      />
    </div>
    <div class="card__caption">
      <h3 class="card__title">{title}</h3>
      {meta && <p class="card__meta">{meta}</p>}
    </div>
    {kind && <p class="card__kind">{kind}</p>}
  </Tag>
</article>

<style>
  .card {
    margin: 0;
  }
  .card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card__media {
    overflow: hidden;
    background: var(--stone); /* shows while the image loads */
  }
  .card--landscape .card__media {
    aspect-ratio: 4 / 3;
  }
  .card--portrait .card__media {
    aspect-ratio: 4 / 5;
  }
  .card--square .card__media {
    aspect-ratio: 1;
  }
  .card__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-top: 0.9rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--hairline);
  }
  .card__title {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--duration-fast) ease;
  }
  .card__link:hover .card__title,
  .card__link:focus-visible .card__title {
    text-decoration-color: var(--accent);
  }
  .card__meta,
  .card__kind {
    margin: 0;
    font-size: var(--step-n1);
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .card__kind {
    margin-top: 0.25rem;
  }
</style>
