---
/**
 * Text link in small spaced capitals with an always-visible fine gold
 * underline (colour alone can't mark a link). Optional arrow.
 *
 *   <TextLink href="/about-us/" arrow>More about us</TextLink>
 */
import type { HTMLAttributes } from 'astro/types';

type Props = {
  href: string;
  /** Show a → after the text */
  arrow?: boolean;
  class?: string;
} & HTMLAttributes<'a'>;

const { href, arrow = false, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['text-link', className]} {...rest}>
  <span class="text-link__label"><slot /></span>{arrow && <span class="text-link__arrow" aria-hidden="true">→</span>}
</a>

<style>
  .text-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6em;
    color: var(--ink);
    font-family: var(--family-text);
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    /* keeps a 44px-ish tap area without changing the visual */
    padding-block: 0.75rem;
  }

  .text-link__label {
    text-decoration: underline;
    text-decoration-color: var(--accent-line);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.7em;
    transition: text-decoration-thickness var(--duration-fast) ease;
  }

  .text-link:hover .text-link__label,
  .text-link:focus-visible .text-link__label {
    text-decoration-thickness: 2px;
  }
</style>
