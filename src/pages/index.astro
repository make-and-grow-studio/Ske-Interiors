---
/**
 * Home page (content/site-content.md, section 1).
 * Sections in order: 1.1 hero, 1.2 studio intro, 1.3 services, 1.4 design vs
 * reality, 1.5 process, 1.6 recent work, 1.7 testimonials, 1.8 estimator,
 * 1.9 FAQ, 1.10 closing call to action.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import StudioIntro from '../components/home/StudioIntro.astro';
import Services from '../components/home/Services.astro';
import Signature from '../components/home/Signature.astro';
import Process from '../components/home/Process.astro';
import RecentWork from '../components/home/RecentWork.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Estimator from '../components/home/Estimator.astro';
import Faq from '../components/home/Faq.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Placeholder from '../components/Placeholder.astro';
import CtaBlock from '../components/CtaBlock.astro';
import TextLink from '../components/ui/TextLink.astro';
import { business, mapUrl, whatsappUrl } from '../data/site';
import { businessSchema, websiteSchema, faqSchema } from '../data/schema';
import { faq, closing } from '../data/home';
import { getHeroImage } from '../lib/hero-image';
import ctaImage from '../../scrape/images/shared/20190131_190716_8eecb74a-f4b3-44ea-997a-e2ce0bf858b2.jpg';

const hero = await getHeroImage();
---

<BaseLayout
  title="Interior Designers in Coimbatore | SKE Interiors"
  description="Home and commercial interiors in Coimbatore since 2011. See your space in 3D before we build, with on-time handover. Get a free quote today."
  headerVariant="overlay"
  jsonLd={[businessSchema, websiteSchema, faqSchema(faq.items)]}
>
  <!-- Start downloading the hero photo before anything else -->
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={hero.avif.srcSet.attribute}
    imagesizes={hero.sizes}
    fetchpriority="high"
  />

  <Hero />
  <StudioIntro />
  <Services />
  <Signature />
  <Process />
  <RecentWork />
  <Testimonials />
  <Estimator />
  <Faq />

  <CtaBlock
    heading={closing.heading}
    text={closing.body}
    primary={{ label: 'Get a free quote', href: '/get-a-quote/' }}
    secondary={{ label: 'WhatsApp us', href: whatsappUrl(), track: 'click_whatsapp', external: true }}
    secondaryAsLink
    image={ctaImage}
    imagePosition="center 60%"
  >
    <Placeholder slot="note">CONFIRM: {closing.bodyConfirm}</Placeholder>
    <div slot="aside" class="cta-aside">
      <p class="cta-aside__label">Visit</p>
      <address>{business.address.full}</address>
      <p class="cta-aside__label">Call</p>
      <p>
        {business.phones.mobile.map((p) => <a href={`tel:${p.tel}`} data-track="click_call">{p.label}</a>)}
      </p>
      <MapEmbed class="cta-aside__map" />
      <TextLink href={mapUrl} arrow target="_blank" rel="noopener">Open in Google Maps</TextLink>
    </div>
  </CtaBlock>
</BaseLayout>

<style>
  .cta-aside address {
    font-style: normal;
    margin-bottom: var(--space-4);
  }
  .cta-aside__label {
    margin: 0 0 0.4rem;
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--gold);
  }
  .cta-aside a[href^='tel'] {
    display: block;
    text-decoration: none;
  }
  .cta-aside :global(.cta-aside__map) {
    margin-bottom: var(--space-2);
  }
  .cta-aside p {
    margin: 0 0 var(--space-4);
  }
</style>
