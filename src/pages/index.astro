---
/**
 * Home page (content/site-content.md, section 1).
 * Built so far: 1.1 hero, 1.2 studio intro, 1.3 services, 1.4 design vs
 * reality, 1.10 closing call to action.
 * Still to come: 1.5 process, 1.6 recent work (06), 1.7–1.9 testimonials, estimator, FAQ (07).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import StudioIntro from '../components/home/StudioIntro.astro';
import Services from '../components/home/Services.astro';
import Signature from '../components/home/Signature.astro';
import CtaBlock from '../components/CtaBlock.astro';
import TextLink from '../components/ui/TextLink.astro';
import { business, mapUrl, whatsappUrl } from '../data/site';
import { businessSchema, websiteSchema } from '../data/schema';
import { getHeroImage } from '../lib/hero-image';
import ctaImage from '../../scrape/images/shared/20190131_190716_8eecb74a-f4b3-44ea-997a-e2ce0bf858b2.jpg';

const hero = await getHeroImage();
---

<BaseLayout
  title="Interior Designers in Coimbatore | SKE Interiors"
  description="Home and commercial interiors in Coimbatore since 2011. See your space in 3D before we build, with on-time handover. Get a free quote today."
  headerVariant="overlay"
  jsonLd={[businessSchema, websiteSchema]}
>
  <!-- Start downloading the hero photo before anything else -->
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={hero.avif.srcSet.attribute}
    imagesizes={hero.sizes}
    fetchpriority="high"
  />

  <Hero />
  <StudioIntro />
  <Services />
  <Signature />

  <CtaBlock
    heading="Let's plan your space."
    text="Tell us about your home or office. We'll call you back within one working day."
    primary={{ label: 'Get a free quote', href: '/get-a-quote/' }}
    secondary={{ label: 'WhatsApp us', href: whatsappUrl(), track: 'click_whatsapp', external: true }}
    secondaryAsLink
    image={ctaImage}
    imagePosition="center 60%"
  >
    <div slot="aside" class="cta-aside">
      <p class="cta-aside__label">Visit</p>
      <address>{business.address.full}</address>
      <p class="cta-aside__label">Call</p>
      <p>
        {business.phones.mobile.map((p) => <a href={`tel:${p.tel}`} data-track="click_call">{p.label}</a>)}
      </p>
      <TextLink href={mapUrl} arrow target="_blank" rel="noopener">Open in Google Maps</TextLink>
    </div>
  </CtaBlock>
</BaseLayout>

<style>
  .cta-aside address {
    font-style: normal;
    margin-bottom: var(--space-4);
  }
  .cta-aside__label {
    margin: 0 0 0.4rem;
    font-size: var(--step-n2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--gold);
  }
  .cta-aside a[href^='tel'] {
    display: block;
    text-decoration: none;
  }
  .cta-aside p {
    margin: 0 0 var(--space-4);
  }
</style>
